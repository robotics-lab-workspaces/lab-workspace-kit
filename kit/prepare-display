#!/bin/bash
set -euo pipefail

state=$1
display=${DISPLAY:-}
authority=${XAUTHORITY:-$HOME/.Xauthority}
if [[ ! $display =~ ^:[0-9]+(\.[0-9]+)?$ || ! -r $authority ]] || ! command -v xauth >/dev/null; then
  exit 0
fi
number=${display#:}
[[ -S /tmp/.X11-unix/X${number%%.*} ]] || exit 0

cookie=$(mktemp "$state/.xauthority.XXXXXXXX")
trap 'rm -f -- "$cookie"' EXIT
if xauth -f "$authority" nlist "$display" | sed 's/^..../ffff/' | xauth -f "$cookie" nmerge - && [[ -s $cookie ]]; then
  mv -- "$cookie" "$state/.mujina-xauthority"
  printf '%s\n' "$display" > "$state/.mujina-display"
fi
